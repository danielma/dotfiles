;;; dm-meow.el --- Meow Config -*- lexical-binding: t -*-

;;; Commentary:

;;; Code:

(use-package undo-tree
  :demand t
  :delight
  :custom
  (undo-tree-history-directory-alist '(("." . "~/.emacs.d/undo")))
  :config
  (global-undo-tree-mode))

(defun dm-consult-line-literal ()
  "Start `consult-line' assuming we want a literal string."
  (interactive)
  (consult-line "=")
  (meow-mark-symbol 0))

(defvar-keymap dm-buffer-command-map
  :doc "Keymap for buffer commands under the Meow leader key."
  "k" #'kill-current-buffer
  "s" #'consult-buffer)

(defvar-keymap dm-snippet-command-map
  :doc "Keymap for snippet commands under the Meow leader key."
  "i" #'yas-insert-snippet
  "n" #'yas-new-snippet
  "v" #'yas-visit-snippet-file)

(defconst dm-meow-cheatsheet-layout-colemak
  '((<TLDE> "`" "~")
    (<AE01> "1" "!") (<AE02> "2" "@") (<AE03> "3" "#")
    (<AE04> "4" "$") (<AE05> "5" "%") (<AE06> "6" "^")
    (<AE07> "7" "&") (<AE08> "8" "*") (<AE09> "9" "(")
    (<AE10> "0" ")") (<AE11> "-" "_") (<AE12> "=" "+")
    (<AD01> "q" "Q") (<AD02> "w" "W") (<AD03> "f" "F")
    (<AD04> "p" "P") (<AD05> "b" "B") (<AD06> "j" "J")
    (<AD07> "l" "L") (<AD08> "u" "U") (<AD09> "y" "Y")
    (<AD10> ":" ";") (<AD11> "[" "{") (<AD12> "]" "}")
    (<AC01> "a" "A") (<AC02> "s" "S") (<AC03> "r" "R")
    (<AC04> "t" "T") (<AC05> "g" "G") (<AC06> "m" "M")
    (<AC07> "n" "N") (<AC08> "e" "E") (<AC09> "i" "I")
    (<AC10> "o" "O") (<AC11> "'" "\"")
    (<AB01> "z" "Z") (<AB02> "x" "X") (<AB03> "c" "C")
    (<AB04> "d" "D") (<AB05> "v" "V") (<AB06> "k" "K")
    (<AB07> "h" "H") (<AB08> "," "<") (<AB09> "." ">")
    (<AB10> "/" "?") (<BKSL> "\\" "|"))
  "Meow cheatsheet layout for the customized QMK Colemak layer.")

(defun dm-meow-setup (layout)
  "Configure Meow for keyboard LAYOUT, either `qwerty' or `colemak'."
  (meow-thing-register 'arrow '(pair ("<") (">")) '(pair ("<") (">")))
  (add-to-list 'meow-char-thing-table '(?a . arrow))
  (meow-leader-define-key
   (cons "b" dm-buffer-command-map)
   (cons "s" dm-snippet-command-map)
   '("p" . "C-x p")
   '("w" . "C-x w")
   ;; Use SPC (0-9) for digit arguments.
   '("1" . meow-digit-argument)
   '("2" . meow-digit-argument)
   '("3" . meow-digit-argument)
   '("4" . meow-digit-argument)
   '("5" . meow-digit-argument)
   '("6" . meow-digit-argument)
   '("7" . meow-digit-argument)
   '("8" . meow-digit-argument)
   '("9" . meow-digit-argument)
   '("0" . meow-digit-argument)
   '("?" . meow-cheatsheet))

  (pcase layout
    ('qwerty
     (setq meow-cheatsheet-layout meow-cheatsheet-layout-qwerty)

     (meow-motion-define-key
      '("j" . meow-next)
      '("k" . meow-prev)
      '("<escape>" . ignore))
     (meow-normal-define-key
      '("0" . meow-expand-0)
      '("1" . meow-expand-1)
      '("2" . meow-expand-2)
      '("3" . meow-expand-3)
      '("4" . meow-expand-4)
      '("5" . meow-expand-5)
      '("6" . meow-expand-6)
      '("7" . meow-expand-7)
      '("8" . meow-expand-8)
      '("9" . meow-expand-9)
      '("-" . negative-argument)
      '("=" . meow-indent)
      '(":" . execute-extended-command)
      '(";" . meow-reverse)
      '("," . meow-inner-of-thing)
      '("." . meow-bounds-of-thing)
      '("[" . meow-beginning-of-thing)
      '("]" . meow-end-of-thing)
      '("<TAB>" . indent-rigidly)
      '("/" . dm-consult-line-literal)
      '("?" . meow-visit)
      '("a" . meow-append)
      '("A" . meow-open-below)
      '("b" . meow-back-word)
      '("B" . meow-back-symbol)
      '("c" . meow-change)
      '("C" . meow-comment)
      '("d" . meow-line)
      '("D" . meow-goto-line)
      '("e" . meow-mark-word)
      '("E" . meow-mark-symbol)
      '("f" . meow-find)
      '("g" . meow-cancel-selection)
      '("G" . meow-grab)
      '("h" . meow-left)
      '("H" . meow-left-expand)
      '("i" . meow-insert)
      '("I" . meow-open-above)
      '("j" . meow-next)
      '("J" . meow-next-expand)
      '("k" . meow-prev)
      '("K" . meow-prev-expand)
      '("l" . meow-right)
      '("L" . meow-right-expand)
      '("m" . meow-join)
      '("n" . meow-search)
      '("o" . meow-block)
      '("O" . meow-to-block)
      '("p" . meow-yank)
      '("q" . meow-quit)
      '("r" . meow-replace)
      '("R" . meow-swap-grab)
      '("s" . meow-kill)
      '("t" . meow-till)
      '("u" . meow-undo)
      '("v" . sp-wrap-interactive)
      '("U" . undo-tree-redo)
      '("w" . meow-next-word)
      '("W" . meow-next-symbol)
      '("x" . meow-delete)
      '("X" . meow-backward-delete)
      '("y" . meow-save)
      '("Y" . meow-sync-grab)
      '("z" . meow-pop-selection)
      '("'" . repeat)
      '("<escape>" . ignore)))

    ('colemak
     (setq meow-cheatsheet-layout dm-meow-cheatsheet-layout-colemak)

     (meow-motion-define-key
      '("n" . meow-next)
      '("e" . meow-prev)
      '("<escape>" . ignore))
     (meow-normal-define-key
      '("0" . meow-expand-0)
      '("1" . meow-expand-1)
      '("2" . meow-expand-2)
      '("3" . meow-expand-3)
      '("4" . meow-expand-4)
      '("5" . meow-expand-5)
      '("6" . meow-expand-6)
      '("7" . meow-expand-7)
      '("8" . meow-expand-8)
      '("9" . meow-expand-9)
      '("-" . negative-argument)
      '("=" . meow-indent)
      '(":" . execute-extended-command)
      '(";" . meow-reverse)
      '("," . meow-inner-of-thing)
      '("." . meow-bounds-of-thing)
      '("[" . meow-beginning-of-thing)
      '("]" . meow-end-of-thing)
      '("<TAB>" . indent-rigidly)
      '("/" . dm-consult-line-literal)
      '("?" . meow-visit)
      '("a" . meow-append)
      '("A" . meow-open-below)
      '("b" . meow-back-word)
      '("B" . meow-back-symbol)
      '("c" . meow-change)
      '("C" . meow-comment)
      '("d" . meow-mark-word)
      '("D" . meow-mark-symbol)
      '("e" . meow-prev)
      '("E" . meow-prev-expand)
      '("f" . meow-find)
      '("g" . meow-cancel-selection)
      '("G" . meow-grab)
      '("h" . meow-join)
      '("i" . meow-right)
      '("I" . meow-right-expand)
      '("j" . meow-replace)
      '("k" . meow-search)
      '("l" . meow-line)
      '("L" . meow-goto-line)
      '("m" . meow-left)
      '("M" . meow-left-expand)
      '("n" . meow-next)
      '("N" . meow-next-expand)
      '("o" . meow-block)
      '("O" . meow-to-block)
      '("p" . meow-yank)
      '("P" . meow-swap-grab)
      '("q" . meow-quit)
      '("r" . meow-insert)
      '("R" . meow-open-above)
      '("s" . meow-kill)
      '("t" . meow-till)
      '("u" . meow-undo)
      '("U" . undo-tree-redo)
      '("v" . sp-wrap-interactive)
      '("w" . meow-next-word)
      '("W" . meow-next-symbol)
      '("x" . meow-delete)
      '("X" . meow-backward-delete)
      '("y" . meow-save)
      '("Y" . meow-sync-grab)
      '("z" . meow-pop-selection)
      '("'" . repeat)
      '("<escape>" . ignore)))
    (_ (user-error "Unsupported Meow keyboard layout: %S" layout))))

(use-package meow
  :config
  (dm-meow-setup 'colemak)
  (meow-global-mode)
  :custom
  (meow-use-cursor-position-hack t)
  (meow-keypad-ctrl-meta-prefix ?/)
  (meow-mode-state-list '((conf-mode . normal)
                          (fundamental-mode . normal)
                          (help-mode . motion)
                          (prog-mode . normal)
                          (text-mode . normal)
                          (git-commit-mode . insert))))

(provide 'dm-meow)

;;; dm-meow.el ends here
