[[ -o interactive ]] || return

typeset -g DOTFILES_ZSH_DIR="$HOME/.dotfiles/zsh"

HISTFILE="$HOME/.zsh_history"
HISTSIZE=10000
SAVEHIST=10000

setopt append_history
setopt extended_history
setopt hist_ignore_all_dups
setopt hist_ignore_space
setopt hist_reduce_blanks
setopt interactive_comments
setopt share_history

bindkey -e
bindkey '^R' history-incremental-search-backward

source "$DOTFILES_ZSH_DIR/completion.zsh"
source "$DOTFILES_ZSH_DIR/prompt.zsh"

export FZF_DEFAULT_OPTS='--cycle --layout=reverse --border --height=90% --preview-window=wrap --color 16,bg+:8,fg+:6,hl+:11,hl:11,border:245'

if command -v brew >/dev/null 2>&1; then
  typeset -g HOMEBREW_PREFIX=$(brew --prefix)

  [[ -r "$HOMEBREW_PREFIX/opt/fzf/shell/completion.zsh" ]] &&
    source "$HOMEBREW_PREFIX/opt/fzf/shell/completion.zsh"
  [[ -r "$HOMEBREW_PREFIX/opt/fzf/shell/key-bindings.zsh" ]] &&
    source "$HOMEBREW_PREFIX/opt/fzf/shell/key-bindings.zsh"
fi

command -v zoxide >/dev/null 2>&1 && source <(zoxide init zsh --cmd c)
command -v direnv >/dev/null 2>&1 && source <(direnv hook zsh)

if [[ -z ${INSIDE_EMACS:-} ]] && command -v emacsclient >/dev/null 2>&1; then
  export EDITOR='emacsclient -nw'
else
  export EDITOR=${EDITOR:-vi}
fi
